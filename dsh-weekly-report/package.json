{
  "name": "dsh-weekly-report",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "description": "周报面板（自主版）：插件自带生成引擎与配置（引擎唯一真源），在侧边栏配置 API Key / 邮箱、一键生成周报、查看历史与注意事项。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "service/server.cjs",
    "service/paths.cjs",
    "service/engine",
    "service/ps",
    "service/public",
    "cordis.patch.yml",
    "install.ps1",
    "start-panel.cmd",
    "locale/*.json",
    "docs",
    "sync-desktop.ps1",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
